<Window x:Class="FamilyShow.PhotoGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FamilyShow"
        Title="Photo Gallery"
        Width="900"
        Height="700"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
  
  <Window.Resources>
    <local:ImageConverter x:Key="ImageConverter" />
    
    <Style x:Key="ThumbnailButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="2"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource FontColor}" />
                <Setter TargetName="border" Property="Background" Value="#20FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="50" />
      <Setter Property="Height" Value="50" />
      <Setter Property="Background" Value="#80000000" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="25">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#B0000000" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#D0000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="15">
      <Grid>
        <TextBlock x:Name="HeaderText"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource HeaderFontColor}"
                   Text="Photo Gallery" />
        <Button HorizontalAlignment="Right"
                Content="&#x25C0;"
                FontSize="20"
                Foreground="{DynamicResource FontColor}"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="CloseButton_Click"
                ToolTip="Close" />
      </Grid>
    </Border>

    <!-- Main content area - switches between thumbnail view and full image view -->
    <Grid x:Name="ThumbnailView" Grid.Row="1" Visibility="Visible"
          AllowDrop="True"
          Drop="ThumbnailView_Drop"
          DragOver="ThumbnailView_DragOver">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <WrapPanel x:Name="ThumbnailPanel"
                   Orientation="Horizontal"
                   Margin="10" />
      </ScrollViewer>
    </Grid>

    <Grid x:Name="FullImageView" Grid.Row="1" Visibility="Collapsed"
          Background="#F0000000">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Full size image -->
      <Viewbox Grid.Row="0" Stretch="Uniform" Margin="20">
        <Image x:Name="FullImage"
               Stretch="Uniform" />
      </Viewbox>

      <!-- Navigation buttons -->
      <Button Grid.Row="0"
              x:Name="PrevButton"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Margin="20,0"
              Content="&#x25C0;"
              Style="{StaticResource NavButtonStyle}"
              Click="PrevButton_Click"
              ToolTip="Previous" />

      <Button Grid.Row="0"
              x:Name="NextButton"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Margin="20,0"
              Content="&#x25B6;"
              Style="{StaticResource NavButtonStyle}"
              Click="NextButton_Click"
              ToolTip="Next" />

      <!-- Image info -->
      <Border Grid.Row="1"
              Background="#D0000000"
              Padding="15">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="ImageCaption"
                     Grid.Column="0"
                     Foreground="White"
                     FontSize="14"
                     Text="Photo caption" />

          <TextBlock x:Name="ImageCounter"
                     Grid.Column="2"
                     Foreground="White"
                     FontSize="14"
                     Text="1 / 5" />
        </Grid>
      </Border>

      <!-- Back to thumbnails button -->
      <Button Grid.Row="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Margin="20"
              Width="40"
              Height="40"
              Background="#80000000"
              Foreground="White"
              BorderThickness="0"
              FontSize="18"
              Content="&#x25C0;"
              Cursor="Hand"
              Click="BackToThumbnails_Click"
              ToolTip="Back to grid" />
    </Grid>

    <!-- Footer with info -->
    <Border Grid.Row="2"
            Background="{DynamicResource PanelGradientBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="15">
      <TextBlock x:Name="FooterText"
                 Foreground="{DynamicResource AlternateFontColor}"
                 FontSize="12"
                 Text="Click a photo to view full size" />
    </Border>
  </Grid>
</Window>
