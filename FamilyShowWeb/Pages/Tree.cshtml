@page
@model FamilyShowWeb.Pages.TreeModel
@{
    ViewData["Title"] = "Family Tree";
    Layout = "_Layout";
}

<div class="tree-view-area" id="treeViewArea">
    @if (Model.FamilyJson != null)
    {
        <!-- View Selector -->
        <div class="view-selector">
            <button class="view-btn" id="listViewBtn" onclick="switchView('list')">List</button>
            <button class="view-btn" id="treeViewBtn" onclick="switchView('tree')">Full Tree</button>
            <button class="view-btn" id="detailsViewBtn" onclick="switchView('details')">Person Details</button>
        </div>

        <!-- List View -->
        <div id="listView" class="content-view" style="display: none;">
            <div class="list-controls">
                <input type="text" id="listFilter" class="list-filter-input" placeholder="Filter by name..." onkeyup="filterList()">
                <span id="list-stats" class="list-stats"></span>
            </div>
            <div class="family-list-container">
                <table class="family-list-table">
                    <thead>
                        <tr>
                            <th class="sortable" onclick="sortList('photos')">??</th>
                            <th class="sortable" onclick="sortList('firstName')">First Name <span class="sort-indicator"></span></th>
                            <th class="sortable" onclick="sortList('lastName')">Last Name <span class="sort-indicator"></span></th>
                            <th class="sortable" onclick="sortList('age')">Age <span class="sort-indicator"></span></th>
                            <th>Living</th>
                            <th class="sortable" onclick="sortList('birthDate')">Birth Date <span class="sort-indicator"></span></th>
                            <th>Birth Place</th>
                            <th>Death Date</th>
                            <th>Death Place</th>
                        </tr>
                    </thead>
                    <tbody id="familyListTableBody">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tree View -->
        <div id="treeView" class="content-view" style="display: none;">
            <div class="tree-controls">
                <label for="focus-person">Focus Person:</label>
                <select id="focus-person" onchange="focusOnPerson(this.value)">
                    <option value="">Select a person...</option>
                </select>
                <button onclick="showFullTree()">Show Full Tree</button>
                <span id="tree-stats"></span>
            </div>
            <div id="tree-container"></div>
        </div>

        <!-- Person Details View -->
        <div id="personDetailsView" class="content-view" style="display: none;">
            <div class="no-data-message">
                <h2>Person Details</h2>
                <p>Select a person from the List or Tree view to see their details here.</p>
            </div>
        </div>
    }
    else
    {
        <div class="no-data-message">
            <h2>No Family Tree Loaded</h2>
            <p>Please open a family file from the File menu to view your family tree.</p>
            <a href="/" class="btn btn-primary">Upload Family File</a>
        </div>
    }
</div>

<!-- Person Details Panel -->
<div class="details-panel" id="detailsPanel">
    <div class="details-panel-header">
        <h3 id="panelPersonName">
            <span class="star-icon">?</span>
            <span>Select a person</span>
        </h3>
        <button class="panel-close-btn" onclick="toggleDetailsPanel()">Close</button>
    </div>
    <div class="details-panel-body">
        <div id="personDetailsContent">
            <!-- Photo Section -->
            <div class="person-photo-section">
                <img id="personPhoto" class="person-photo" src="" alt="Person Photo" style="display:none;">
                <div id="personNameLarge" class="person-name">Select a person from the tree</div>
                <div id="personDates" class="person-dates"></div>
            </div>

            <!-- Detail Tabs -->
            <div class="detail-tabs">
                <button class="detail-tab active" onclick="showTab('details')">Details</button>
                <button class="detail-tab" onclick="showTab('relationships')">Relationships</button>
                <button class="detail-tab" onclick="showTab('photos')">Photos & Stories</button>
            </div>

            <!-- Details Tab -->
            <div id="tab-details" class="tab-content active">
                <div class="info-field">
                    <div class="info-label">First Name</div>
                    <div class="info-value" id="detailFirstName">-</div>
                </div>
                <div class="info-field">
                    <div class="info-label">Last Name</div>
                    <div class="info-value" id="detailLastName">-</div>
                </div>
                <div class="info-field">
                    <div class="info-label">Birth Date</div>
                    <div class="info-value" id="detailBirthDate">-</div>
                </div>
                <div class="info-field">
                    <div class="info-label">Birth Place</div>
                    <div class="info-value" id="detailBirthPlace">-</div>
                </div>
                <div class="info-field">
                    <div class="info-label">Death Date</div>
                    <div class="info-value" id="detailDeathDate">-</div>
                </div>
                <div class="info-field">
                    <div class="info-label">Death Place</div>
                    <div class="info-value" id="detailDeathPlace">-</div>
                </div>
                <button class="edit-person-btn" onclick="editCurrentPerson()">
                    <i class="bi bi-pencil"></i> Edit Person
                </button>
            </div>

            <!-- Relationships Tab -->
            <div id="tab-relationships" class="tab-content">
                <h4 style="color: var(--header-font-color); margin-bottom: 1rem;">Family Relationships</h4>
                <ul class="relationships-list" id="relationshipsList">
                    <li style="color: var(--alternate-font-color); text-align: center; padding: 2rem;">
                        Select a person to view relationships
                    </li>
                </ul>
                <button class="edit-person-btn" onclick="showAddRelationshipDialog()">
                    <i class="bi bi-person-plus"></i> Add Relationship
                </button>
            </div>

            <!-- Photos & Stories Tab -->
            <div id="tab-photos" class="tab-content">
                <h4 style="color: var(--header-font-color); margin-bottom: 1rem;">Photos</h4>
                <div id="photosGrid" style="color: var(--alternate-font-color); text-align: center; padding: 2rem;">
                    No photos available
                </div>
                <h4 style="color: var(--header-font-color); margin: 2rem 0 1rem;">Stories</h4>
                <div id="storiesContent" style="color: var(--alternate-font-color); text-align: center; padding: 2rem;">
                    No stories available
                </div>
            </div>
        </div>

        <!-- Family List Section (always visible at bottom) -->
        <div class="family-list-section">
            <div class="family-list-header">
                <h4>Family (<span id="familyCount">0</span>)</h4>
                <button class="expand-toggle" onclick="toggleFamilyList()">Expand</button>
            </div>
            <input type="text" class="family-filter" placeholder="Filter by name..." id="familyFilter" onkeyup="filterFamilyList()">
            <div id="familyListContent" style="max-height: 0; overflow: hidden; transition: max-height 0.3s;">
                <!-- Family members will be populated here -->
            </div>
                </div>
            </div>
        </div>

        @if (Model.FamilyJson != null)
        {
            <!-- Load dagre FIRST, then cytoscape-dagre -->
            <script src="https://unpkg.com/dagre@0.8.5/dist/dagre.min.js"></script>
            <script src="https://unpkg.com/cytoscape@3.24.0/dist/cytoscape.min.js"></script>
            <script src="https://unpkg.com/cytoscape-dagre@2.4.0/cytoscape-dagre.js"></script>
            <script src="~/js/family-tree-layout.js" asp-append-version="true"></script>
            <script src="~/js/tree-renderer.js" asp-append-version="true"></script>
            <script>
            console.log('=== Tree.cshtml Script Starting ===');
            var familyData = @Html.Raw(Model.FamilyJson ?? "null");
            console.log('Family data received:', familyData);
            console.log('Family data type:', typeof familyData);
            console.log('PeopleCollection exists:', familyData && familyData.PeopleCollection);
            console.log('PeopleCollection length:', familyData && familyData.PeopleCollection ? familyData.PeopleCollection.length : 0);

            if (!familyData) {
                console.error('No family data available. Please upload a family file first.');
                var container = document.getElementById('tree-container');
                if (container) {
                    container.innerHTML = '<div class="no-data-message">No family data available. Please <a href="/">upload a family file</a> first.</div>';
                }
            }

            // Check if tree-container exists
            var treeContainer = document.getElementById('tree-container');
            console.log('tree-container element exists:', !!treeContainer);

            // Use enhanced cytoscape style from tree-renderer
            var cy = cytoscape({
                container: treeContainer,
                elements: [],
                style: window.TreeRenderer ? window.TreeRenderer.getEnhancedCytoscapeStyle() : [
                    { 
                        selector: 'node', 
                        style: { 
                            'label': 'data(label)', 
                            'background-color': '#007bff', 
                            'color': '#fff', 
                            'text-valign': 'bottom', 
                            'text-halign': 'center',
                            'width': '50px',
                            'height': '70px',
                            'shape': 'rectangle',
                            'font-size': '11px',
                            'font-weight': '600',
                            'text-wrap': 'wrap',
                            'text-max-width': '80px',
                            'border-width': '2px',
                            'border-color': '#0056b3',
                            'transition-property': 'background-color, border-color, width, height',
                            'transition-duration': '0.3s'
                        } 
                },
                {
                    selector: 'node.focused',
                    style: {
                        'background-color': '#FF6B35',
                        'border-width': '4px',
                        'border-color': '#FF8C00',
                        'width': '160px',
                        'height': '80px',
                        'font-size': '15px',
                        'font-weight': 'bold'
                    }
                },
                {
                    selector: 'node.ancestor',
                    style: {
                        'background-color': '#28a745',
                        'border-color': '#1e7e34'
                    }
                },
                {
                    selector: 'node.descendant',
                    style: {
                        'background-color': '#6f42c1',
                        'border-color': '#5a32a3'
                    }
                },
                {
                    selector: 'node.spouse',
                    style: {
                        'background-color': '#fd7e14',
                        'border-color': '#dc6502'
                    }
                },
                {
                    selector: 'node.sibling',
                    style: {
                        'background-color': '#20c997',
                        'border-color': '#138496'
                    }
                },
                {
                    selector: 'node.hidden',
                    style: {
                        'opacity': 0.1
                    }
                },
                { 
                    selector: 'edge', 
                    style: { 
                        'width': 3, 
                        'line-color': '#888', 
                        'target-arrow-color': '#888', 
                        'target-arrow-shape': 'triangle',
                        'curve-style': 'bezier',
                        'arrow-scale': 1.5,
                        'transition-property': 'line-color, target-arrow-color, opacity',
                        'transition-duration': '0.3s'
                    } 
                },
                {
                    selector: 'edge.hidden',
                    style: {
                        'opacity': 0.1
                    }
                },
                {
                    selector: 'edge[type="parent-child"]',
                    style: {
                        'line-color': '#4CAF50',
                        'target-arrow-color': '#4CAF50',
                        'width': 4
                    }
                },
                {
                    selector: 'edge[type="spouse"]',
                    style: {
                        'line-color': '#FF9800',
                        'target-arrow-shape': 'none',
                        'line-style': 'dashed',
                        'width': 3
                    }
                }
            ],
            layout: { name: 'dagre', directed: true, padding: 20, rankDir: 'TB' }
        });

        // Build nodes and edges from familyData
        var allNodes = [];
        var allEdges = [];
        var currentFocusId = null;
        
        // Helper functions to get relationships from Relatives array
        function getRelatives(person, relationType) {
            return person.Relatives ? person.Relatives.filter(rel => rel.RelationType === relationType) : [];
        }
        
        function getParents(person) {
            return getRelatives(person, 'Parent');
        }
        
        function getChildren(person) {
            return getRelatives(person, 'Child');
        }
        
        function getSpouses(person) {
            return getRelatives(person, 'Spouse');
        }
        
        function getSiblings(person) {
            return getRelatives(person, 'Sibling');
        }
        
        if (familyData && familyData.PeopleCollection && familyData.PeopleCollection.length > 0) {
            console.log('Family data loaded:', familyData);
            console.log('Number of people:', familyData.PeopleCollection.length);
            
            // First, add all persons as nodes
            familyData.PeopleCollection.forEach(function(person) {
                console.log('Processing person:', person);
                allNodes.push({ 
                    data: { 
                        id: person.Id, 
                        label: person.FullName || (person.FirstName + ' ' + person.LastName),
                        person: person
                    } 
                });
            });
            
            // Populate the focus person dropdown (sorted by name)
            var focusSelect = document.getElementById('focus-person');
            var sortedPeople = [...familyData.PeopleCollection].sort((a, b) => {
                const nameA = (a.LastName || '') + ', ' + (a.FirstName || '');
                const nameB = (b.LastName || '') + ', ' + (b.FirstName || '');
                return nameA.localeCompare(nameB);
            });
            sortedPeople.forEach(function(person) {
                var option = document.createElement('option');
                option.value = person.Id;
                option.text = person.FullName || (person.FirstName + ' ' + person.LastName);
                focusSelect.appendChild(option);
            });
            
            // Then, build relationships from the Relatives collection
            familyData.PeopleCollection.forEach(function(person) {
                if (person.Relatives) {
                    person.Relatives.forEach(function(relative) {
                        var relatedPersonId = relative.PersonId;
                        var relationType = relative.RelationType;
                        
                        console.log(`${person.FullName || (person.FirstName + ' ' + person.LastName)} -> ${relative.PersonName} (${relationType})`);
                        
                        if (relationType === 'Parent') {
                            // Parent to child relationship
                            allEdges.push({ 
                                data: { 
                                    id: relatedPersonId + '_to_' + person.Id, 
                                    source: relatedPersonId, 
                                    target: person.Id, 
                                    type: 'parent-child'
                                } 
                            });
                        } else if (relationType === 'Child') {
                            // Child relationship (reverse of parent)
                            allEdges.push({ 
                                data: { 
                                    id: person.Id + '_to_' + relatedPersonId, 
                                    source: person.Id, 
                                    target: relatedPersonId, 
                                    type: 'parent-child'
                                } 
                            });
                        } else if (relationType === 'Spouse') {
                            // Spouse relationship (undirected, only add once)
                            if (person.Id < relatedPersonId) {
                                allEdges.push({ 
                                    data: { 
                                        id: person.Id + '_spouse_' + relatedPersonId, 
                                        source: person.Id, 
                                        target: relatedPersonId, 
                                        type: 'spouse'
                                    } 
                                });
                            }
                        }
                    });
                }
            });
            
            console.log('All Nodes:', allNodes);
            console.log('All Edges:', allEdges);
            
            // Find a good default person to focus on (first person with parents and children, or just first person)
            var defaultPerson = familyData.PeopleCollection.find(p => {
                var parents = getParents(p);
                var children = getChildren(p);
                return parents.length > 0 && children.length > 0;
            }) || familyData.PeopleCollection[0];
            
            if (defaultPerson) {
                focusOnPerson(defaultPerson.Id);
                focusSelect.value = defaultPerson.Id;
            } else {
                showFullTree();
            }
        } else {
            console.error('No valid family data found or empty people collection');
            document.getElementById('tree-container').innerHTML = '<div class="no-data-message">No family data available. Please <a href="/">upload a family file</a> first.</div>';
        }
        
        function updateTreeStats() {
            var visibleNodes = cy.nodes().filter(node => !node.hasClass('hidden'));
            var totalNodes = allNodes.length;
            document.getElementById('tree-stats').textContent = 
                `Showing ${visibleNodes.length} of ${totalNodes} people`;
        }
        
        function showFullTree() {
            currentFocusId = null;
            cy.elements().remove();
            cy.add(allNodes);
            cy.add(allEdges);

            // Remove all classes
            cy.nodes().removeClass('focused ancestor descendant spouse sibling hidden');
            cy.edges().removeClass('hidden');

            // Layout and fit
            var layout = cy.layout({ 
                name: 'dagre', 
                directed: true, 
                padding: 30,
                rankDir: 'TB',
                ranker: 'longest-path',
                spacingFactor: 1.5,
                animate: true,
                animationDuration: 500
            });

            layout.on('layoutstop', function() {
                // Apply SVG rendering to all nodes after layout completes
                if (window.TreeRenderer && window.TreeRenderer.applySVGToAllNodes) {
                    window.TreeRenderer.applySVGToAllNodes(cy, familyData);
                }
            });

            layout.run();

            document.getElementById('focus-person').value = '';
            updateTreeStats();
        }
        
        function focusOnPerson(personId) {
            if (!personId) return;

            console.log('Focusing on person:', personId);
            currentFocusId = personId;
            var person = familyData.PeopleCollection.find(p => p.Id === personId);
            if (!person) return;

            // Use custom family tree layout
            const treeLayout = new FamilyTreeLayout(familyData);
            const { nodes, edges } = treeLayout.calculateLayout(personId);

            console.log('Custom layout generated:', nodes.length, 'nodes,', edges.length, 'edges');

            // Clear and rebuild the graph
            cy.elements().remove();
            cy.add(nodes);
            cy.add(edges);

            // Apply SVG rendering after adding nodes
            if (window.TreeRenderer && window.TreeRenderer.applySVGToAllNodes) {
                setTimeout(() => {
                    window.TreeRenderer.applySVGToAllNodes(cy, familyData);
                }, 100);
            }

            // Fit the view to show all nodes
            setTimeout(() => {
                cy.fit(50);
                cy.center();
            }, 200);

            updateTreeStats();
            updateTreeStats();
        }

        // Helper to get ancestors/descendants
        function getAncestors(personId, depth=1) {
            var ancestors = [];
            var person = familyData.PeopleCollection.find(p => p.Id === personId);
            if (person && person.Parents && depth > 0) {
                person.Parents.forEach(parent => {
                    ancestors.push(parent);
                    ancestors = ancestors.concat(getAncestors(parent.Id, depth-1));
                });
            }
            return ancestors;
        }
        function getDescendants(personId, depth=1) {
            var descendants = [];
            var person = familyData.PeopleCollection.find(p => p.Id === personId);
            if (person && person.Children && depth > 0) {
                person.Children.forEach(child => {
                    descendants.push(child);
                    descendants = descendants.concat(getDescendants(child.Id, depth-1));
                });
            }
            return descendants;
        }

        // Person info modal with navigation
        function showPersonModal(personId) {
            var person = familyData.PeopleCollection.find(function(p){ return p.Id === personId; });
            if (person) {
                var modal = document.getElementById('person-modal');
                var ancestors = getAncestors(person.Id, 2);
                var descendants = getDescendants(person.Id, 2);
                modal.innerHTML = `<h3>${person.FullName}</h3>
                    <p><b>Birth:</b> ${person.BirthDate || ''} ${person.BirthPlace || ''}</p>
                    <p><b>Death:</b> ${person.DeathDate || ''} ${person.DeathPlace || ''}</p>
                    <p><b>Parents:</b> ${(person.Parents || []).map(p => `<a href='#' onclick='focusOnPerson("${p.Id}"); document.getElementById("person-modal").style.display="none";'>${p.FullName}</a>`).join(', ')}</p>
                    <p><b>Spouses:</b> ${(person.Spouses || []).map(s => `<a href='#' onclick='focusOnPerson("${s.Id}"); document.getElementById("person-modal").style.display="none";'>${s.FullName}</a>`).join(', ')}</p>
                    <p><b>Children:</b> ${(person.Children || []).map(c => `<a href='#' onclick='focusOnPerson("${c.Id}"); document.getElementById("person-modal").style.display="none";'>${c.FullName}</a>`).join(', ')}</p>
                    <hr>
                    <b>Extended Family:</b><br>
                    <b>Ancestors:</b> ${(ancestors || []).map(a => `<a href='#' onclick='focusOnPerson("${a.Id}"); document.getElementById("person-modal").style.display="none";'>${a.FullName}</a>`).join(', ')}<br>
                    <b>Descendants:</b> ${(descendants || []).map(d => `<a href='#' onclick='focusOnPerson("${d.Id}"); document.getElementById("person-modal").style.display="none";'>${d.FullName}</a>`).join(', ')}<br>
                    <hr>
                    <button onclick="focusOnPerson('${person.Id}'); document.getElementById('focus-person').value='${person.Id}'; document.getElementById('person-modal').style.display='none';">Focus on ${person.FirstName}</button>
                    <button onclick="document.getElementById('person-modal').style.display='none'">Close</button>
                    <button onclick="showEditForm('${person.Id}')">Edit</button>`;
                modal.style.display = 'block';
            }
        }
        cy.on('tap', 'node', function(evt){
            var personId = evt.target.id();
            var person = familyData.PeopleCollection.find(p => p.Id === personId);
            if (person) {
                updatePersonDetails(person);
                // Also focus the tree on this person
                document.getElementById('focus-person').value = personId;
            }
        });

        // Populate family list in side panel
        if (typeof populateFamilyList === 'function') {
            populateFamilyList(familyData.PeopleCollection);
        }

        // Populate list view table and set default view
        // Wrap in a small delay to ensure DOM is ready
        setTimeout(function() {
            console.log('Initializing list view...');
            console.log('populateListView function exists:', typeof populateListView);
            console.log('switchView function exists:', typeof switchView);
            console.log('People count:', familyData.PeopleCollection ? familyData.PeopleCollection.length : 0);

            if (typeof populateListView === 'function') {
                populateListView(familyData.PeopleCollection);
                console.log('List view populated');
            } else {
                console.error('populateListView function not found!');
            }

            // Set default view to List
            if (typeof switchView === 'function') {
                switchView('list');
                console.log('Switched to list view');
            } else {
                console.error('switchView function not found!');
            }
        }, 100);

        // Make familyData globally accessible
        window.familyData = familyData;

        // Edit form modal
        window.showEditForm = function(personId) {
            var person = familyData.PeopleCollection.find(function(p){ return p.Id === personId; });
            if (person) {
                var modal = document.getElementById('person-modal');
                modal.innerHTML = `<h3>Edit ${person.FullName}</h3>
                    <form id='edit-person-form'>
                        <label>First Name: <input name='FirstName' value='${person.FirstName}' /></label><br>
                        <label>Last Name: <input name='LastName' value='${person.LastName}' /></label><br>
                        <label>Birth Date: <input name='BirthDate' value='${person.BirthDate || ''}' /></label><br>
                        <label>Birth Place: <input name='BirthPlace' value='${person.BirthPlace || ''}' /></label><br>
                        <label>Death Date: <input name='DeathDate' value='${person.DeathDate || ''}' /></label><br>
                        <label>Death Place: <input name='DeathPlace' value='${person.DeathPlace || ''}' /></label><br>
                        <button type='button' onclick='saveEditPerson("${person.Id}")'>Save</button>
                        <button type='button' onclick='document.getElementById("person-modal").style.display="none"'>Cancel</button>
                    </form>`;
                modal.style.display = 'block';
            }
        }
        window.saveEditPerson = function(personId) {
            var form = document.getElementById('edit-person-form');
            var person = familyData.PeopleCollection.find(function(p){ return p.Id === personId; });
            if (person) {
                person.FirstName = form.FirstName.value;
                person.LastName = form.LastName.value;
                person.BirthDate = form.BirthDate.value;
                person.BirthPlace = form.BirthPlace.value;
                person.DeathDate = form.DeathDate.value;
                person.DeathPlace = form.DeathPlace.value;
                document.getElementById('person-modal').style.display = 'none';
                cy.getElementById(person.Id).data('label', person.FirstName + ' ' + person.LastName);
            }
        }
    </script>
}
else
{
    <div>No family data loaded. Please upload a file on the home page.</div>
}
